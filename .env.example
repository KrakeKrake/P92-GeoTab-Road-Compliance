# Copy to .env and edit. Docker Compose reads .env automatically.
# Everything here is optional unless marked REQUIRED.

# project
COMPOSE_PROJECT_NAME=nhvr-compliance
NETWORK_NAME=nhvr_compliance_default
# Pinned so changing COMPOSE_PROJECT_NAME cannot orphan the database volume.
DB_VOLUME_NAME=nhvr-compliance-pgdata

# images
# One Docker Hub repository that holds all four images as different tags:
#   <repo>:valhalla-<tag>, <repo>:compliance-api-<tag>,
#   <repo>:web-app-<tag>, <repo>:geotools-<tag>
# Set this before `docker compose build && docker compose push`.
IMAGE_REPO=docker.io/krakekrake/eat40005
IMAGE_TAG=latest

# container user for Valhalla / NHVR tools (they write into custom_files)
# Rootless Podman: leave 0:0 (container root maps to your user).
# Rootful Docker: set to `id -u` / `id -g` so setup.sh/update.sh can move the
# files the containers create.
PUID=0
PGID=0

# data inputs (REQUIRED)
# Directory containing the NHVR *.gpkg files.
NHVR_GPKG_DIR=./nhvr_gpkg
# Directory containing the base OSM extract, and the file to use inside it.
# Keeping the directory + filename separate means a missing file is a clear
# script error instead of Docker creating a directory in its place.
# Below is an example for 
OSM_PBF_DIR=./osm.pbf
OSM_PBF_NAME=victoria-260907.osm.pbf

# postgres 
DB_NAME=nhvr_compliance
DB_USER=nhvr
# IMPORTANT:
# Use a URL-safe password, or the API's SQLAlchemy URL will need escaping.
DB_PASSWORD=change-me-to-a-url-safe-password
DB_BIND_ADDR=127.0.0.1
# Only used by docker-compose.override.yml / setup.sh on the host.
DB_DEBUG_PORT=5432

# published ports
# In deployment only the web app is published. The other ports are opened by
# docker-compose.override.yml for local debugging.
WEB_BIND_ADDR=0.0.0.0
WEB_PORT=8080
API_DEBUG_PORT=5000
VALHALLA_DEBUG_PORT=8002
VALHALLA_CORS_PORT=8003
ADMINER_PORT=5433

# valhalla 
# Leave empty to use all CPUs.
VALHALLA_BUILD_CONCURRENCY=
VALHALLA_BUILD_TYPE=Release
VALHALLA_LOG_LEVEL=INFO
VALHALLA_BUILD_ADMINS=True
VALHALLA_BUILD_TIME_ZONES=True
VALHALLA_BUILD_ELEVATION=False
VALHALLA_BUILD_TRANSIT=False
VALHALLA_SERVER_THREADS=

# web app (runtime config)
# /valhalla and /api are proxied by the web app's nginx, so the browser only
# ever talks to one origin. An empty VITE_NHVR_API_URL means "same origin".
VITE_VALHALLA_URL=/valhalla
VITE_NHVR_API_URL=
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
VITE_CENTER_COORDS=-37.8136,144.9631
VITE_DEFAULT_COSTING_MODEL=truck
VITE_CLIENT_ID=nhvr-web-app

# compliance api 
API_WORKERS=2
